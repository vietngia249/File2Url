# Environment Variables — Expiring File Link Service

# Server
PORT=3000
# [FIX-9] Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://user:pass@localhost:5432/fileup

# Cloudflare R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY=<YOUR_R2_ACCESS_KEY_ID>
R2_SECRET_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
R2_BUCKET=<YOUR_BUCKET_NAME>

# [FIX-8] CORS — set to your frontend's exact origin (no trailing slash)
# Example: https://app.yourdomain.com
ALLOWED_ORIGIN=https://file2url-1.onrender.com

# ---------------------------------------------------------------------------
# V2 Configurations
# ---------------------------------------------------------------------------

# JWT Secret for Authentication
JWT_SECRET=super-secret-v2-key-change-in-prod

# Google Drive Integration Details
GDRIVE_CLIENT_ID=your_google_cloud_id.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=your_google_cloud_secret
GDRIVE_REDIRECT_URI=https://file2url-nsdd.onrender.com/auth/google/callback
